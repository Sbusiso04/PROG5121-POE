import java.util.ArrayList;
import java.util.List;

// Message class to hold individual message attributes
class Message {
    private String recipient;
    private String messageText;
    private String flag;
    private String messageId;
    private String messageHash;

    public Message(String recipient, String messageText, String flag, String messageId, String messageHash) {
        this.recipient = recipient;
        this.messageText = messageText;
        this.flag = flag;
        this.messageId = messageId;
        this.messageHash = messageHash;
    }

    public String getRecipient() { return recipient; }
    public String getMessageText() { return messageText; }
    public String getFlag() { return flag; }
    public String getMessageId() { return messageId; }
    public String getMessageHash() { return messageHash; }
}

public class MessageManager {
    // Arrays / Lists as required by the task
    private List<String> sentMessages = new ArrayList<>();
    private List<String> disregardedMessages = new ArrayList<>();
    private List<String> storedMessages = new ArrayList<>();
    private List<String> messageHash = new ArrayList<>();
    private List<String> messageID = new ArrayList<>();
    
    // Master list to hold all structured Message objects for reporting & searching
    private List<Message> masterMessageList = new ArrayList<>();

    // Method to populate data based on test data inputs
    public void addMessage(String recipient, String messageText, String flag, String messageId, String hash) {
        Message msg = new Message(recipient, messageText, flag, messageId, hash);
        masterMessageList.add(msg);
        messageID.add(messageId);
        messageHash.add(hash);

        if (flag.equalsIgnoreCase("Sent")) {
            sentMessages.add(messageText);
        } else if (flag.equalsIgnoreCase("Disregard") || flag.equalsIgnoreCase("Disregarded")) {
            disregardedMessages.add(messageText);
        } else if (flag.equalsIgnoreCase("Stored")) {
            storedMessages.add(messageText);
        }
    }

    // 2.a. Display the sender and recipient of all stored messages
    public String displaySenderAndRecipientOfStored() {
        StringBuilder sb = new StringBuilder();
        for (Message m : masterMessageList) {
            if (m.getFlag().equalsIgnoreCase("Stored")) {
                sb.append("Recipient: ").append(m.getRecipient())
                  .append(", Message: ").append(m.getMessageText()).append("\n");
            }
        }
        return sb.toString().trim();
    }

    // 2.b. Display the longest stored/active message
    public String displayLongestMessage() {
        if (masterMessageList.isEmpty()) return "";
        Message longest = masterMessageList.get(0);
        for (Message m : masterMessageList) {
            if (m.getMessageText().length() > longest.getMessageText().length()) {
                longest = m;
            }
        }
        return longest.getMessageText();
    }

    // 2.c. Search for a message ID and display corresponding recipient and message
    public String searchByMessageID(String id) {
        for (Message m : masterMessageList) {
            if (m.getMessageId().equals(id)) {
                return "\"" + m.getRecipient() + "\",\n\"" + m.getMessageText() + "\"";
            }
        }
        return "Message ID not found.";
    }

    // 2.d. Search for all messages stored for a particular recipient
    public String searchMessagesByRecipient(String recipient) {
        StringBuilder sb = new StringBuilder();
        for (Message m : masterMessageList) {
            if (m.getRecipient().equals(recipient)) {
                sb.append("\"").append(m.getMessageText()).append("\" ");
            }
        }
        return sb.toString().trim();
    }

    // 2.e. Delete a message using a message hash
    public boolean deleteMessageByHash(String hash) {
        for (int i = 0; i < masterMessageList.size(); i++) {
            if (masterMessageList.get(i).getMessageHash().equals(hash)) {
                masterMessageList.remove(i);
                messageHash.remove(hash);
                return true;
            }
        }
        return false;
    }

    // 2.f. Display a report that lists full details of all stored/sent messages
    public String displayReport() {
        StringBuilder sb = new StringBuilder();
        for (Message m : masterMessageList) {
            sb.append("Message Hash: ").append(m.getMessageHash())
              .append(", Recipient: ").append(m.getRecipient())
              .append(", Message: ").append(m.getMessageText()).append("\n");
        }
        return sb.toString().trim();
    }

    public List<String> getSentMessages() { return sentMessages; }
}
